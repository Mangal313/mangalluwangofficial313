{
  "name": "game-recharge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "prepare": "prisma generate",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:studio": "npx prisma studio",
    "db:seed": "ts-node --esm prisma/seed.ts",
    "test": "jest --runInBand",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "@prisma/client": "5.0.0",
    "argon2": "^0.30.0",
    "bcrypt": "^5.1.0",
    "next": "14.0.0",
    "next-auth": "^5.0.0",
    "nodemailer": "^6.9.3",
    "prisma": "5.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "stripe": "^12.0.0",
    "zod": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "20.0.0",
    "@types/react": "18.0.0",
    "autoprefixer": "^10.4.14",
    "eslint": "8.0.0",
    "eslint-config-next": "14.0.0",
    "jest": "^29.0.0",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.4.24",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.1",
    "typescript": "5.2.2"
  }
}
